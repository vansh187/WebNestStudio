VITE_API_BASE_URL=https://webneststudiobackend-n00h.onrender.com

# The Java playground endpoint is a constant in src/lib/codelab/javaRunner.js (no env var).
# Never place a Google token/API secret in a VITE_ variable.

# GitHub sync: 1 = use the in-memory mock (dev only) instead of the backend /api/github routes.
# The GitHub client secret lives on the backend only (see GITHUB_INTEGRATION_BACKEND.md).
VITE_GITHUB_MOCK=0
