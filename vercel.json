{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "webneststudio.co.in"
        }
      ],
      "destination": "https://www.webneststudio.co.in/:path*",
      "permanent": true
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.png",
      "permanent": true
    },
    {
      "source": "/playground",
      "destination": "/codelab/playground",
      "permanent": true
    },
    {
      "source": "/services/software-development",
      "destination": "/software-development-company-gurugram",
      "permanent": true
    },
    {
      "source": "/services/ai-development",
      "destination": "/ai-development-company-india",
      "permanent": true
    },
    {
      "source": "/blog/react-frontend-with-python-and-java-backend-development-for-scaling-businesses-2",
      "destination": "/blog/react-frontend-with-python-and-java-backend-development-for-scaling-businesses",
      "permanent": true
    },
    {
      "source": "/blog/react-frontend-with-python-and-java-backend-the-ultimate-tech-stack-for-growing-businesses",
      "destination": "/blog/react-frontend-with-python-and-java-backend-development-for-scaling-businesses",
      "permanent": true
    },
    {
      "source": "/learn/java",
      "destination": "/learn/java-core",
      "permanent": true
    },
    {
      "source": "/learn/lessons/lesson_java_overview",
      "destination": "/learn/lessons/lesson_java_core_history_and_features_of_java",
      "permanent": true
    },
    {
      "source": "/learn/lessons/lesson_python_overview",
      "destination": "/learn/lessons/lesson_python_syntax",
      "permanent": true
    },
    {
      "source": "/learn/lessons/lesson_python_input",
      "destination": "/learn/lessons/lesson_python_http_api_basics",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/codelab/problems/sum-two-smoke",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/portal/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/projects/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/delete-account",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/s/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/codelab/dashboard",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/login",
      "destination": "/app-private"
    },
    {
      "source": "/admin/:path*",
      "destination": "/app-private"
    },
    {
      "source": "/portal/:path*",
      "destination": "/app-private"
    },
    {
      "source": "/projects/:path*",
      "destination": "/app-private"
    },
    {
      "source": "/delete-account",
      "destination": "/app-private"
    },
    {
      "source": "/s/:path*",
      "destination": "/app-private"
    },
    {
      "source": "/codelab/dashboard",
      "destination": "/app-private"
    }
  ]
}
